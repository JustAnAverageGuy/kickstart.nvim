          "",
          "",
          "def prime_factors(n):",
          "    t = n",
          "    if n == 0: return defaultdict(int)",
          "    f = defaultdict(int)",
          "    if not(t&1):",
          "        while not(t&1):",
          "            f[2] += 1",
          "            t >>= 1",
          "    i = 3",
          "    while i * i <= t:",
          "        if t % i == 0:",
          "            while t % i == 0:",
          "                f[i] += 1",
          "                t //= i",
          "        i += 2",
          "    if t>1: f[t] += 1",
